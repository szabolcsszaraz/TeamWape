        public System.Collections.Generic.IEnumerable<IMarker> GetMarkers();
        protected virtual void OnAfterTrackDeserialize();
        protected virtual void OnBeforeTrackSerialize();
        protected virtual void OnCreateClip(TimelineClip clip);
    }

    public static class TrackAssetExtensions
    {
        public static GroupTrack GetGroup(this TrackAsset asset);
        public static void SetGroup(this TrackAsset asset, GroupTrack group);
    }

    [System.Flags] public enum TrackBindingFlags
    {
        All = 1,
        AllowCreateComponent = 1,
        None = 0,
    }

    [System.AttributeUsage(System.AttributeTargets.Class)] public class TrackBindingTypeAttribute : System.Attribute
    {
        public readonly TrackBindingFlags flags = TrackBindingFlags.AllowCreateComponent|TrackBindingFlags.All;
        public readonly System.Type type;
        public TrackBindingTypeAttribute(System.Type type) {}
        public TrackBindingTypeAttribute(System.Type type, TrackBindingFlags flags) {}
    }

    [System.AttributeUsage(System.AttributeTargets.Class, AllowMultiple = true)] public class TrackClipTypeAttribute : System.Attribute
    {
        public readonly bool allowAutoCreate = true;
        public readonly System.Type inspectedType;
        public TrackClipTypeAttribute(System.Type clipClass) {}
        public TrackClipTypeAttribute(System.Type clipClass, bool allowAutoCreate) {}
    }

    [System.AttributeUsage(System.AttributeTargets.Class)] public class TrackColorAttribute : System.Attribute
    {
        public Color color { get; }
        public TrackColorAttribute(float r, float g, float b) {}
    }

    [System.AttributeUsage(System.AttributeTargets.Class)] [System.Obsolete(@"TrackMediaType has been deprecated. It is no longer required, and will be removed in a future release.", false)] public class TrackMediaType : System.Attribute
    {
        public readonly TimelineAsset.MediaType m_MediaType;
        public TrackMediaType(TimelineAsset.MediaType mt) {}
    }

    public enum TrackOffset
    {
        ApplySceneOffsets = 1,
        ApplyTransformOffsets = 0,
        Auto = 2,
    }
}
