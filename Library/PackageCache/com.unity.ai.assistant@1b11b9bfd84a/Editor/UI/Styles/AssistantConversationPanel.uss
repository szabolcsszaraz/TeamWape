.assistantconversationpanel__element {
    flex-grow: 1;
}

.assistantconversationpanel__element-root {
    flex-grow: 1;
}

.mui-conversation-overlay-elements {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    top: 0;
    align-items: center;
}

#conversationScrollToBottomButton {
    position: absolute;
    bottom: 12px;
}

#conversationRoot {
    flex-grow: 1;
}

/* Scoped to the surface as well as the conversation root: the checkpoint panel shows a chat surface of
   its own, outside #conversationRoot, and its scrollbar is the same scrollbar. */
#conversationRoot .unity-base-slider__dragger,
.mui-chat-surface-root .unity-base-slider__dragger {
    background-color: var(--muse-chat-conversation-dragger);
}

#conversationRoot .unity-base-slider__dragger:hover,
.mui-chat-surface-root .unity-base-slider__dragger:hover {
    background-color: var(--muse-chat-conversation-dragger-hover);
}

.mui-message-cost-label {
    font-size: 11px;
    color: var(--muse-chat-text-secondary);
    align-self: center;
}
