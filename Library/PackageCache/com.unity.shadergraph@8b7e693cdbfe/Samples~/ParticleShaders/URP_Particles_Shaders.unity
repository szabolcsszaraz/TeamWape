    - target: {fileID: 7284084073945457638, guid: 2623538bed5e9c64dafa64546f2d8115, type: 3}
      propertyPath: m_text
      value: Custom Particle Data (Particle Age)
      objectReference: {fileID: 0}
    - target: {fileID: 7284084073945457638, guid: 2623538bed5e9c64dafa64546f2d8115, type: 3}
