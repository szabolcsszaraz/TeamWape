      objectReference: {fileID: 0}
    - target: {fileID: 7259234020276392320, guid: 48107805786efdc498d52bd1ec950d4f, type: 3}
      propertyPath: m_text
      value: "\nThis example fades transparent particles near opaque geometry, so as to avoid hard clipping where particles overlap scene objects. This is similar to URP Particle Shaders\u2019 \u201CSoft Particles\u201D option.\nThe upper system\u2019s material shows Soft Particles, while the lower one shows clipping artefacts that occur without it.\n\nOpen the shader graph for more information.\n\n<b>Covered Aspects:</b>\n\u2022 Scene Depth Node\n\u2022 Screen Position Node"
      objectReference: {fileID: 0}
    - target: {fileID: 7259234020276392320, guid: 48107805786efdc498d52bd1ec950d4f, type: 3}
      propertyPath: m_fontSize
      value: 0.5
      objectReference: {fileID: 0}
    - target: {fileID: 8746263480829534621, guid: 48107805786efdc498d52bd1ec950d4f, type: 3}
      propertyPath: m_text
      value: Soft Particles
      objectReference: {fileID: 0}
    - target: {fileID: 8746263480829534621, guid: 48107805786efdc498d52bd1ec950d4f, type: 3}
      propertyPath: m_fontSize
      value: 1.8
      objectReference: {fileID: 0}
