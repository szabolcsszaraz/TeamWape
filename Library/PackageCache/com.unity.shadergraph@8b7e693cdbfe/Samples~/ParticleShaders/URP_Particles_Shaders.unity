      objectReference: {fileID: 0}
    - target: {fileID: 8704122679672230907, guid: 2623538bed5e9c64dafa64546f2d8115, type: 3}
      propertyPath: m_text
      value: "\nThis example shows how to use Custom Vertex Streams to use Particle Data in the shader, either using vertex streams with Billboards or custom ParticleData struct with Mesh and GPU Instancing enabled.\nHere the Particle Age is used to dissolve particles.\n\n<b>Covered Aspects:</b>\n\u2022 Particle Systems Vertex Streams"
      objectReference: {fileID: 0}
    - target: {fileID: 8704122679672230907, guid: 2623538bed5e9c64dafa64546f2d8115, type: 3}
      propertyPath: m_fontSize
      value: 0.5
      objectReference: {fileID: 0}
