    - target: {fileID: 5968324525673992124, guid: 89979f13a55b303459fec809c3b17ac8, type: 3}
      propertyPath: m_text
      value: "\nLike Particle Graph Templates, all examples work on Particle Systems with Render Mode set to Billboard or Mesh, with or without GPU Instancing enabled, by using Particle Data nodes from the Shader Functions Library, such as Particle Transforms, Color and TexCoords.\n\nOpen the shader graph for more information.\n\n<b>Covered Aspects:</b>\n\u2022 Particle Transforms\n\u2022 Particle Color\n\u2022 Particle Texcoords"
      objectReference: {fileID: 0}
    - target: {fileID: 5968324525673992124, guid: 89979f13a55b303459fec809c3b17ac8, type: 3}
      propertyPath: m_fontSize
      value: 0.7
      objectReference: {fileID: 0}
