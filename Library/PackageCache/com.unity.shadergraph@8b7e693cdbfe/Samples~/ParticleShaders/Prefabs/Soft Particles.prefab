    - target: {fileID: 3496643972403736682, guid: 506427f5b26814641b42d9e60b88a66a, type: 3}
      propertyPath: m_text
      value: "\nThis example fades transparent particles near opaque geometry, so as to avoid hard clipping where particles overlap scene objects. This is similar to URP Particle Shaders\u2019 \u201CSoft Particles\u201D option.\nThe upper system\u2019s material shows Soft Particles, while the lower one shows clipping artefacts that occur without it.\n\n<b>Covered Aspects:</b>\n\u2022 Scene Depth Node\n\u2022 Screen Position Node"
      objectReference: {fileID: 0}
    - target: {fileID: 4186845547563547082, guid: 506427f5b26814641b42d9e60b88a66a, type: 3}
      propertyPath: UVModule.tilesX
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 4186845547563547082, guid: 506427f5b26814641b42d9e60b88a66a, type: 3}
      propertyPath: UVModule.tilesY
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 4186845547563547082, guid: 506427f5b26814641b42d9e60b88a66a, type: 3}
      propertyPath: UVModule.enabled
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4186845547563547082, guid: 506427f5b26814641b42d9e60b88a66a, type: 3}
      propertyPath: InitialModule.startSize.scalar
