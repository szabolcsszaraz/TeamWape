      objectReference: {fileID: 0}
    - target: {fileID: 3144218529481488709, guid: 2277623b13d517e4d9195b9954de3c00, type: 3}
      propertyPath: m_text
      value: "\nThis example uses the (new) Particle Flipbook Blending subgraph.\nThe upper system\u2019s material has blending enabled, while the lower one has it disabled.\nWhen using Billboard or Mesh with GPU Instancing disabled, it expects Custom Vertex Streams set to: Color, UV, UV2 and AnimBlend.\nNote, Normal is also required for Lit, and Tangent if Normal Maps are used.\nWhen GPU Instancing is disabled, a mesh where UV1 is the same as UV0 is required.\nWhen using Mesh with GPU Instancing enabled, this requires no Custom Vertex Streams.\n\n<b>Covered Aspects:</b>\n\u2022 Texture Sheet Animation\n\u2022 Flipbook Blending"
      objectReference: {fileID: 0}
    - target: {fileID: 3144218529481488709, guid: 2277623b13d517e4d9195b9954de3c00, type: 3}
      propertyPath: m_fontSize
      value: 0.5
      objectReference: {fileID: 0}
    - target: {fileID: 3926998905021024600, guid: 2277623b13d517e4d9195b9954de3c00, type: 3}
      propertyPath: m_text
      value: Flipbook Blending
      objectReference: {fileID: 0}
    - target: {fileID: 3926998905021024600, guid: 2277623b13d517e4d9195b9954de3c00, type: 3}
      propertyPath: m_fontSize
      value: 1.8
      objectReference: {fileID: 0}
    - target: {fileID: 6622053598129776562, guid: 2277623b13d517e4d9195b9954de3c00, type: 3}
      propertyPath: m_text
