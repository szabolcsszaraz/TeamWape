    - target: {fileID: 7919817897386539615, guid: acb63dfd66e3dd04caebbc8b845aea59, type: 3}
      propertyPath: m_text
      value: "\nThis example fades transparent particles near the camera, so as to avoid hard clipping where particles come near the Camera clipping plane. This is similar to URP Particle Shader \u201CCamera Fade\u201D option.\n\n<b>Covered Aspects:</b>\n\u2022 Flipbook Blending"
      objectReference: {fileID: 0}
    - target: {fileID: 7919817897386539615, guid: acb63dfd66e3dd04caebbc8b845aea59, type: 3}
