{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "ba5f13d7dd944d8ea4e0c6de56cadc78",
    "m_Title": "",
    "m_Content": "When the Particle System uses Billboard Render Mode (or Mesh with GPU Instancing disabled), it simply outputs what is connected to its input. Here using UV0.z.\n\r\nWhen the Particle System uses Mesh Render Mode with GPU Instancing enabled, fetches the per particle AgePercent value from the StructuredBuffer<>.\n\nThis expects Custom Vertex Streams to be set up:\nPosition\nNormal (if using Lit)\nTangent (if using Normap Maps in Tangent space)\nUV\nAgePercent",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1549.0,
        "y": 1023.0,
        "width": 499.0,
        "height": 183.81982421875
    },
    "m_Group": {
        "m_Id": "75725e3b9e2e449991d3e693e67d5858"
    }
}

