{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "8cca6c796e3e4af0bb1c56f5a9930222",
    "m_Title": "",
    "m_Content": "When using Mesh Render Mode with GPU Instancing enabled, the Particle Transforms node transforms vertex data from Object (Particle) Space to Object (System) Space.\r\n",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -572.0,
        "y": -411.0,
        "width": 267.0,
        "height": 100.0
    },
    "m_Group": {
        "m_Id": "c7b058decce741cd9f0ce69476d46475"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "8e12585ccd5643cf95868bd5bfd49cfe",
    "m_Title": "Particle Instancing & Particle Functions",
    "m_Content": "This shader graph is set up to support Mesh Particle GPU Instancing.\r\n\r\nUsing any of the Particle Data nodes (Transforms, Color, TexCoords, AnimFrame) will result in including ParticleInstancing.hlsl and so requires adding the following pragma to the Preprocessor Directives in the Graph Settings.\r\ninstancing_options procedural:ParticleInstancingSetup\r\n",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1388.0,
        "y": -642.0,
        "width": 760.0,
        "height": 316.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

