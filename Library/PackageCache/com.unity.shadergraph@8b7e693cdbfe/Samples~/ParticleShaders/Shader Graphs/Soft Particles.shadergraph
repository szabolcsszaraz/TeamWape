{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "3959ca93c67544e7bc083c66a9742dc5",
    "m_Title": "Particle Instancing & Particle Functions",
    "m_Content": "This shader graph is set up to support Mesh Particle GPU Instancing.\r\n\r\nUsing any of the Particle Data nodes (Transforms, Color, TexCoords, AnimFrame) will result in including ParticleInstancing.hlsl and so requires adding the following pragma to the Preprocessor Directives in the Graph Settings.\r\ninstancing_options procedural:ParticleInstancingSetup\r\n",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -755.0,
        "y": -615.0,
        "width": 760.0,
        "height": 316.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

