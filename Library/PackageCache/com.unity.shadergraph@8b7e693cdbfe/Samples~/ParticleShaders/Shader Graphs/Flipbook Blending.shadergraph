{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "14404b15d2ab4312bca012215ed27ac3",
    "m_Title": "",
    "m_Content": "When the Particle System is using a Texture Sheet Animation module, the Particle Flipbook Blending subgraph samples the same texture twice, using the Particle UV of the current and next frames, and blends them using the blend factor.\r\n\r\nWhen used with Billboards or Mesh with GPU Instancing disabled, it is expected to be fed the Vertex Stream source for the Blend Amount (usually UV1.x).\r\nWith Mesh and GPU Instancing enabled, it internally uses the fraction of the AnimFrame.\r\n\r\nThe subgraph also adds a _FLIPBOOKBLENDING_ON Shader Feature Keyword.\r\nWhen left disabled (default) it will just sample the texture with the UVs of the current animation frame.\r\n",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -966.0,
        "y": 443.0,
        "width": 541.0,
        "height": 173.07315063476563
    },
    "m_Group": {
        "m_Id": "a7466e9db00f49e9a72320ad44eb4c2c"
    }
}

