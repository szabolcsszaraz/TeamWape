{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "a272447640e24b78a2b90a94fdc3da5b",
    "m_Title": "",
    "m_Content": "When the Particle System uses Billboard Render Mode (or Mesh with GPU Instancing disabled), it simply outputs what is connected to its input (defaults to Vertex Color).\n\r\nWhen the Particle System uses Mesh Render Mode with GPU Instancing enabled, it multiplies the input by the Particle Color stored in the Particle Data Structured Buffer.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -690.0,
        "y": 42.0,
        "width": 267.0,
        "height": 150.0
    },
    "m_Group": {
