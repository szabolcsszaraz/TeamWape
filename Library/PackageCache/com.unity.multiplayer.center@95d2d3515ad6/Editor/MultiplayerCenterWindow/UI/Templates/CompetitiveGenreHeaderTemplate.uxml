<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Packages/com.unity.multiplayer.center/Editor/MultiplayerCenterWindow/UI/Templates/HeaderStyle.uss?fileID=7433441132597879392&amp;guid=2f1d5cde0e95bf04ea03dd1d0e7c3e2b&amp;type=3#HeaderStyle"/>
    <ui:VisualElement name="VisualElement" class="main-container">
        <ui:Label text="Fast paced competitive" class="title">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="DisplayName" data-source-type="Unity.Multiplayer.Center.Editor.GameGenreDescription, Unity.Multiplayer.Center.Editor" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Label>
        <Unity.Multiplayer.Center.Editor.ImageWithPlaceholderElement class="genre-image"/>
    </ui:VisualElement>
</ui:UXML>
