.main-container {
    flex-grow: 1;
    flex-direction: row;
    height: 200px;
    min-width: 450px;
    background-color: var(--genre-header-bg);
    padding-left: 36px;
    padding-right: 36px;
}

.title {
    -unity-text-align: middle-left;
    letter-spacing: 0.35px;
    font-size: 19px;
    flex-grow: 1;
    align-self: center;
    -unity-text-auto-size: best-fit 10px 25px;
    -unity-editor-text-rendering-mode: sdf;
    padding-top: 4px;
    white-space: nowrap;
    flex-shrink: 1;
}

.genre-image {
    padding-top: 8px;
    flex-grow: 0;
    flex-shrink: 1;
    aspect-ratio: 1;
    position: absolute;
    right: 36px;
    align-content: stretch;
    justify-content: space-between;
    align-self: flex-end;
    max-height: 100%;
    filter: opacity(0.83);
    height: 100%;
    align-items: flex-end;
    flex-direction: column;
}

.genre-image  .place-holder__icon {
    align-self: center;
    align-content: center;
    min-width: 32px;
    min-height: 32px;
    height: 75%;
    width: 75%;
    aspect-ratio: 1;
    margin-right: 32px;
    margin-bottom: 16px;
    background-image: var(--icon-unity-cube);
}

.genre-image  .place-holder__icon:hover {
    height: 75.5%;
    width: 75.5%;
}
