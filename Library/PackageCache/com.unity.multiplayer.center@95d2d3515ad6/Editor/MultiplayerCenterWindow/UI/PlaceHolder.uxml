<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; border-top-width: 0; max-width: 400px; border-right-color: rgb(0, 0, 0);">
        <ui:VisualElement name="VisualElement" style="flex-grow: 0; border-top-width: 2px; border-top-color: rgb(0, 0, 0); border-left-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-bottom-color: rgb(0, 0, 0); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); margin-bottom: 16px; padding-top: 6px; padding-right: 6px; padding-bottom: 6px; padding-left: 6px;">
            <ui:VisualElement style="flex-grow: 0; flex-direction: row; align-items: stretch; justify-content: flex-end; border-left-color: rgb(44, 93, 135); border-right-color: rgb(44, 93, 135); border-top-color: rgb(44, 93, 135); border-bottom-color: rgb(44, 93, 135);">
                <ui:VisualElement style="flex-grow: 0; width: 40px; height: 14px; background-color: rgb(44, 93, 135); border-top-left-radius: 5.5px; border-top-right-radius: 5.5px; border-bottom-right-radius: 5.5px; border-bottom-left-radius: 5.5px; margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px;"/>
                <ui:VisualElement style="flex-grow: 0; width: 14px; height: 14px; border-top-left-radius: 5.5px; border-top-right-radius: 5.5px; border-bottom-right-radius: 5.5px; border-bottom-left-radius: 5.5px; background-color: rgb(31, 31, 31); margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px;"/>
                <ui:VisualElement style="flex-grow: 0; width: 14px; height: 14px; border-top-left-radius: 5.5px; border-top-right-radius: 5.5px; border-bottom-right-radius: 5.5px; border-bottom-left-radius: 5.5px; background-color: rgb(31, 31, 31); margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px;"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 0; align-items: flex-start;">
                <ui:VisualElement style="flex-grow: 1; width: 84px; height: 10px; background-color: rgb(31, 31, 31); margin-top: 4px; margin-bottom: 4px; border-top-left-radius: 5.5px; border-top-right-radius: 5.5px; border-bottom-right-radius: 5.5px; border-bottom-left-radius: 5.5px;"/>
                <ui:VisualElement style="flex-grow: 1; height: 5.5px; width: 200px; background-color: rgb(31, 31, 31); border-top-left-radius: 5.5px; border-top-right-radius: 5.5px; border-bottom-right-radius: 5.5px; border-bottom-left-radius: 5.5px;"/>
                <ui:VisualElement style="flex-grow: 1; height: 5.5px; width: 72px; background-color: rgb(31, 31, 31); margin-top: 32px; border-top-left-radius: 5.5px; border-top-right-radius: 5.5px; border-bottom-right-radius: 5.5px; border-bottom-left-radius: 5.5px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="Install the package(s) to see additional content such as samples and shortcuts" style="white-space: normal; -unity-text-align: upper-center;"/>
    </ui:VisualElement>
</ui:UXML>
