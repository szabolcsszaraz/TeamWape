/* override the default label style so that all texts adapt to small space by default */
.unity-label {
    overflow: hidden;
    text-overflow: ellipsis;
}

/* used on the UI root object when in question mode */
.question-mode {

}

/* by default anything under a .question class is hidden */
.question {
    display: none;
}

#right-panel {
    min-width: var(--content-panel-min-width);
}

#question-description {
    min-width: var(--content-panel-min-width);
}

/* .question is displayed when in question mode */
.question-mode .question {
    display: flex;
}

/* by default .category is displayed */
.category {
    display: flex;
}

/* .category is hidden when in question mode */
.question-mode .category {
    display: none;
}

/* --- Main styling --- */

.header {
    flex-direction: row;
    align-items: center;
    height: 36px;
    background-color: var(--unity-colors-toolbar-background);
    border-color: var(--unity-colors-toolbar-border);
    border-bottom-width: 1px;
}

.header__title {
    font-size: 14px;
    flex-grow: 1;
    -unity-text-align: middle-center;
}

.left-panel {
    min-width: 160px;
    overflow: hidden;
    background-color: var(--unity-colors-window-secondary-background);
}

.multiplayer-listview__element {
    padding-left: 10px;
    -unity-text-align: middle-left;
    flex-grow: 1;
}

/* --- Question section specifics --- */

.answer-button {
    height: 24px;
    margin: 5px;
}

/* --- Categories section specifics --- */

.category-section {
    margin: 25px 15px 0 15px;
    padding: 0;
}

.section-headline {
    font-size: 14px;
    padding-bottom: 15px;
}

.section-title {
    -unity-font-style: bold;
    padding: 0 0 10px 0;
}

.section-description {
    white-space: pre-wrap;
}

#back-button{
    margin-left: 8px;
    background-image: var(--back-button-icon);
    background-size: 16px;
    width: 22px;
    height: 22px;
}

HyperLink{
    color: var(--link-color);
    height: 16px;
    border-bottom-width: 1px;
    border-bottom-color: transparent;
    align-self: flex-start;
}

HyperLink:hover{
    cursor: link;
    color: var(--link-hover-color);
    border-bottom-color: var(--link-hover-color);
}

HyperLink:active{
    color: var(--link-active-color);
    border-bottom-color: var(--link-active-color);
}

.hyperlink-separator{
    width: 2px;
    background-color: var(--theme-slider-background-color);
    margin-left: 8px;
    margin-right: 8px;
    border-bottom-right-radius: 5px;
}

.sample-pill {
    flex-direction: row;
    background-color: var(--unity-colors-input_field-background);
    border-color: var(--unity-colors-input_field-border);
    border-width: 1px;
    align-items: center;
    align-self: flex-start;
    flex-shrink: 0;
    padding: 2px 5px 2px 5px;
    margin-bottom: 10px;
}

.sample-pill Label {
    letter-spacing: 0.15px;
    font-size: 10px;
    overflow: visible;
    text-overflow: clip;
}
